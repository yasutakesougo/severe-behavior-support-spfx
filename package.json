{
  "name": "severe-behavior-support-spfx",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "lint:fix": "eslint src tests scripts --fix --max-warnings 0",
    "check:contracts-boundaries": "node scripts/ci/check-contracts-boundaries.mjs",
    "check:scope": "node scripts/ci/check-scope.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "verify:contracts": "npm run typecheck && npm test && npm run check:contracts-boundaries",
    "verify:ci": "npm run verify:skills && npm run lint && npm run typecheck && npm test && npm run check:contracts-boundaries && npm run check:scope",
    "handoff:auto": "node scripts/auto-handoff.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.66.0"
  }
}
