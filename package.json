{
  "name": "severe-behavior-support-spfx",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "test": "tsx --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "lint:fix": "eslint src tests scripts --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contracts-boundaries": "node scripts/ci/check-contracts-boundaries.mjs",
    "check:scope": "node scripts/ci/check-scope.mjs",
    "check:a11y": "node scripts/ci/check-accessibility-gate.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "verify:ui-catalog": "node scripts/verify-ui-catalog.mjs",
    "verify:contracts": "npm run typecheck && npm test && npm run check:contracts-boundaries",
    "verify:ci": "npm run verify:skills && npm run verify:ui-catalog && npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:contracts-boundaries && npm run check:scope && npm run check:a11y",
    "handoff:auto": "node scripts/auto-handoff.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.66.0"
  }
}
